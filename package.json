{
  "name": "package-management-project",
  "version": "1.0.1",
  "description": "Node.js project demonstrating dependency management, versioning and application packaging",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "start:dev": "APP_ENV=development PORT=3000 node src/app.js",
    "start:staging": "APP_ENV=staging PORT=4000 node src/app.js",
    "build": "npm pack --pack-destination dist",
    "audit": "npm audit"
  },
